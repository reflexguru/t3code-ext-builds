+        // Keep one start timestamp per tool so later updates report a duration.
+        const nativeItemId = `tool-${toolCallId}`;
+        const startedAt = turn.toolStartedAt.get(nativeItemId) ?? emittedAt;
+        turn.toolStartedAt.set(nativeItemId, startedAt);
+        const nodeStatus: OrchestrationV2ExecutionNode["status"] =
