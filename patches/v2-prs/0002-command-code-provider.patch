+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeURL from "node:url";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { HostProcessPlatform } from "@t3tools/shared/hostProcess";
+import {
+  NodeId,
+  ProviderInstanceId,
+  ProviderSessionId,
+  RunAttemptId,
+  RunId,
+  ThreadId,
+  type CommandCodeSettings,
+  type ModelSelection,
+  type OrchestrationV2AppThread,
+  type OrchestrationV2ProviderThread,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Stream from "effect/Stream";
+import { ChildProcessSpawner } from "effect/unstable/process";
+import { describe, expect, it } from "@effect/vitest";
+
+import { ServerConfig } from "../../config.ts";
+import { IdAllocatorV2, layer as idAllocatorLayer } from "../IdAllocator.ts";
+import type {
+  ProviderAdapterV2Event,
+  ProviderAdapterV2SessionRuntime,
+} from "../ProviderAdapter.ts";
+import { makeCommandCodeAdapterV2 } from "./CommandCodeAdapterV2.ts";
+
+const MOCK_AGENT_PATH = NodeURL.fileURLToPath(
+  new URL(
+    "../../provider/testFixtures/commandCodeHeadless/commandcode-mock-agent.cjs",
+    import.meta.url,
+  ),
+);
+
+const hostPlatform = HostProcessPlatform.defaultValue();
+
+function prepareMockHarness(): {
+  readonly binaryPath: string;
+  readonly argvLogPath: string;
+  readonly cwd: string;
+} {
+  const cwd = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-cc-adapter-v2-"));
+  const argvLogPath = NodePath.join(cwd, "argv.json");
+  const isWindows = hostPlatform === "win32";
+  const binaryPath = NodePath.join(cwd, isWindows ? "command-code.cmd" : "command-code");
+  NodeFS.writeFileSync(
+    binaryPath,
+    isWindows
+      ? `@echo off\r\nnode "${MOCK_AGENT_PATH}" %*\r\n`
+      : `#!/usr/bin/env sh\nexec node '${MOCK_AGENT_PATH.replaceAll("'", "'\"'\"'")}' "$@"\n`,
+  );
+  if (!isWindows) {
+    NodeFS.chmodSync(binaryPath, 0o755);
+  }
+  return { binaryPath, argvLogPath, cwd };
+}
+
+const cleanupHarness = (cwd: string) =>
+  Effect.sync(() => NodeFS.rmSync(cwd, { recursive: true, force: true }));
+
+const serverConfigLayer = ServerConfig.layerTest(process.cwd(), {
+  prefix: "t3-commandcode-v2-adapter-",
+}).pipe(Layer.provide(NodeServices.layer));
+
+const testLayer = Layer.mergeAll(NodeServices.layer, idAllocatorLayer, serverConfigLayer);
+
+const INSTANCE_ID = ProviderInstanceId.make("commandCodeTest");
+const THREAD_ID = ThreadId.make("thread-1");
+const SESSION_ID = ProviderSessionId.make("provider-session-1");
+
+const runtimePolicy = {
+  runtimeMode: "full-access",
+  interactionMode: "default",
+  cwd: null,
+} as const;
+
+const modelSelection: ModelSelection = {
+  instanceId: INSTANCE_ID,
+  model: "deepseek/deepseek-v4-flash",
+};
+
+function makeSettings(binaryPath: string): CommandCodeSettings {
+  return {
+    enabled: true,
+    binaryPath,
+    permissionMode: "auto-accept",
+    launchArgs: "",
+    customModels: [],
+  } as unknown as CommandCodeSettings;
+}
+
+function readArgvLog(path: string): { argv: string[]; prompt: string } {
+  return JSON.parse(NodeFS.readFileSync(path, "utf8")) as { argv: string[]; prompt: string };
+}
+
+const makeAdapter = (input: {
+  readonly settings: CommandCodeSettings;
+  readonly environment: NodeJS.ProcessEnv;
+}) =>
+  Effect.gen(function* () {
+    const idAllocator = yield* IdAllocatorV2;
+    const serverConfig = yield* ServerConfig;
+    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+    return makeCommandCodeAdapterV2({
+      instanceId: INSTANCE_ID,
+      ...input,
+      idAllocator,
+      serverConfig,
+      spawner,
+    });
+  });
+
+const makeAppThread = Effect.fnUntraced(function* () {
+  const now = yield* DateTime.now;
+  return {
+    createdBy: "user",
+    creationSource: "web",
+    id: THREAD_ID,
+    projectId: "project:fixture:commandcode",
+    title: "Command Code test thread",
+    providerInstanceId: INSTANCE_ID,
+    modelSelection,
+    runtimeMode: "full-access",
+    interactionMode: "default",
+    branch: null,
+    worktreePath: null,
+    activeProviderThreadId: null,
+    lineage: { parentThreadId: null, relationshipToParent: null, rootThreadId: THREAD_ID },
+    forkedFrom: null,
+    createdAt: now,
+    updatedAt: now,
+    archivedAt: null,
+    settledOverride: null,
+    settledAt: null,
+    lastVisitedAt: null,
+    deletedAt: null,
+  } as OrchestrationV2AppThread;
+});
+
+interface OpenRuntime {
+  readonly runtime: ProviderAdapterV2SessionRuntime;
+  readonly providerThread: OrchestrationV2ProviderThread;
+  /** Resolve the next matching event, discarding everything before it. */
+  readonly takeEvent: (
+    predicate: (event: ProviderAdapterV2Event) => boolean,
+  ) => Effect.Effect<ProviderAdapterV2Event>;
+  /** Collect every event up to and including the turn's terminal event. */
+  readonly collectUntilTerminal: () => Effect.Effect<ReadonlyArray<ProviderAdapterV2Event>>;
+}
+
+const openRuntime = (
+  harness: ReturnType<typeof prepareMockHarness>,
+  mockEnv: NodeJS.ProcessEnv = {},
+) =>
+  Effect.gen(function* () {
+    const adapter = yield* makeAdapter({
+      settings: makeSettings(harness.binaryPath),
+      environment: { ...process.env, T3_MOCK_ARGV_LOG: harness.argvLogPath, ...mockEnv },
+    });
+    const runtime = yield* adapter.openSession({
+      threadId: THREAD_ID,
+      providerSessionId: SESSION_ID,
+      modelSelection,
+      runtimePolicy,
+    });
+    const providerThread = yield* runtime.ensureThread({
+      threadId: THREAD_ID,
+      modelSelection,
+      runtimePolicy,
+    });
+    const emitted = yield* Queue.unbounded<ProviderAdapterV2Event>();
+    yield* runtime.events.pipe(
+      Stream.runForEach((event) => Queue.offer(emitted, event)),
+      Effect.forkScoped,
+    );
+    const takeEvent = (predicate: (event: ProviderAdapterV2Event) => boolean) =>
+      Effect.gen(function* () {
+        while (true) {
+          const event = yield* Queue.take(emitted);
+          if (predicate(event)) return event;
+        }
+      });
+    const collectUntilTerminal = () =>
+      Effect.gen(function* () {
+        const collected: Array<ProviderAdapterV2Event> = [];
+        while (true) {
+          const event = yield* Queue.take(emitted);
+          collected.push(event);
+          if (event.type === "turn.terminal") return collected;
+        }
+      });
+    return { runtime, providerThread, takeEvent, collectUntilTerminal };
+  });
+
+const startTurn = (state: OpenRuntime, text: string, ordinal = 1) =>
+  Effect.gen(function* () {
+    const runId = RunId.make(`run:${THREAD_ID}:${ordinal}`);
+    const appThread = yield* makeAppThread();
+    yield* state.runtime.startTurn({
+      appThread,
+      threadId: THREAD_ID,
+      runId,
+      runOrdinal: ordinal,
+      providerTurnOrdinal: ordinal,
+      attemptId: RunAttemptId.make(`run-attempt:${runId}:1`),
+      rootNodeId: NodeId.make(`node:${runId}:root`),
+      providerThread: state.providerThread,
+      message: {
+        messageId: `message:${THREAD_ID}:${ordinal}` as never,
+        text,
+        attachments: [],
+        createdBy: "user",
+        creationSource: "web",
+      },
+      modelSelection,
+      runtimePolicy,
+    });
+    return runId;
+  });
+
+const steerTurn = (state: OpenRuntime, runId: RunId, providerTurnId: string, text: string) =>
+  state.runtime.steerTurn({
+    threadId: THREAD_ID,
+    runId,
+    providerThread: state.providerThread,
+    providerTurnId: providerTurnId as never,
+    message: {
+      messageId: `message:${THREAD_ID}:steer` as never,
+      text,
+      attachments: [],
+      createdBy: "user",
+      creationSource: "web",
+    },
+  });
+
+const runningTurnId = (state: OpenRuntime) =>
+  Effect.gen(function* () {
+    const event = yield* state.takeEvent(
+      (candidate) =>
+        candidate.type === "provider_turn.updated" && candidate.providerTurn.status === "running",
+    );
+    return event.type === "provider_turn.updated" ? event.providerTurn.id : "";
+  });
+
+const firstAssistantText = (state: OpenRuntime) =>
+  state.takeEvent(
+    (event) =>
+      event.type === "message.updated" &&
+      event.message.role === "assistant" &&
+      event.message.text.includes("Hola"),
+  );
+
+describe("CommandCodeAdapterV2 (mock CLI)", () => {
+  it.live(
+    "runs a successful turn, streams assistant text, and adopts the session id",
+    () => {
+      const harness = prepareMockHarness();
+      return Effect.gen(function* () {
+        const state = yield* openRuntime(harness);
+
+        yield* startTurn(state, "hola");
+        const events = yield* state.collectUntilTerminal();
+
+        const completedMessage = events.find(
+          (event) =>
+            event.type === "message.updated" &&
+            event.message.role === "assistant" &&
+            event.message.text === "Hola, mundo" &&
+            !event.message.streaming,
+        );
+        expect(completedMessage).toBeDefined();
+
+        const terminal = events.at(-1);
+        expect(terminal?.type).toBe("turn.terminal");
+        expect(terminal?.type === "turn.terminal" && terminal.status).toBe("completed");
+        expect(terminal?.type === "turn.terminal" && terminal.failure).toBeNull();
+
+        // The run's session id is adopted as the thread's native ref.
+        expect(
+          events.some(
+            (event) =>
+              event.type === "provider_thread.updated" &&
+              event.providerThread.nativeThreadRef?.nativeId === "mock-session-1",
+          ),
+        ).toBe(true);
+
+        // First run carried --yolo and the requested model.
+        const firstArgv = readArgvLog(harness.argvLogPath);
+        expect(firstArgv.prompt).toBe("hola");
+        expect(firstArgv.argv).toContain("--yolo");
+        expect(firstArgv.argv).toContain("--model");
+        expect(firstArgv.argv).toContain("deepseek/deepseek-v4-flash");
+      }).pipe(
+        Effect.ensuring(cleanupHarness(harness.cwd)),
+        Effect.scoped,
+        Effect.provide(testLayer),
+      );
+    },
+    30_000,
+  );
+
+  it.live(
+    "resumes the adopted Command Code session on the next turn",
+    () => {
+      const harness = prepareMockHarness();
+      return Effect.gen(function* () {
+        const state = yield* openRuntime(harness);
+
+        yield* startTurn(state, "hola", 1);
+        yield* state.collectUntilTerminal();
+
+        yield* startTurn(state, "segundo", 2);
+        yield* state.collectUntilTerminal();
+
+        const resumedArgv = readArgvLog(harness.argvLogPath);
+        expect(resumedArgv.prompt).toBe("segundo");
+        expect(resumedArgv.argv).toContain("--resume");
+        expect(resumedArgv.argv).toContain("mock-session-1");
+      }).pipe(
+        Effect.ensuring(cleanupHarness(harness.cwd)),
+        Effect.scoped,
+        Effect.provide(testLayer),
+      );
+    },
+    30_000,
+  );
+
+  it.live(
+    "interrupts an in-flight turn and emits a clean interrupted terminal",
+    () => {
+      const harness = prepareMockHarness();
+      return Effect.gen(function* () {
+        const state = yield* openRuntime(harness, { T3_MOCK_HANG: "1" });
+
+        yield* startTurn(state, "tarea larga");
+        const providerTurnId = yield* runningTurnId(state);
+        // Wait until the mock has streamed its first assistant chunk (the
+        // child is running and holding), then interrupt it.
+        yield* firstAssistantText(state);
+
+        yield* state.runtime.interruptTurn({
+          providerThread: state.providerThread,
+          providerTurnId: providerTurnId as never,
+        });
+
+        const events = yield* state.collectUntilTerminal();
+        const terminal = events.at(-1);
+        expect(terminal?.type).toBe("turn.terminal");
+        expect(terminal?.type === "turn.terminal" && terminal.status).toBe("interrupted");
+        expect(terminal?.type === "turn.terminal" && terminal.failure).toBeNull();
+      }).pipe(
+        Effect.ensuring(cleanupHarness(harness.cwd)),
+        Effect.scoped,
+        Effect.provide(testLayer),
+      );
+    },
+    30_000,
+  );
+
+  it.live(
+    "queues a mid-turn steer and runs it in the same turn",
+    () => {
+      const harness = prepareMockHarness();
+      return Effect.gen(function* () {
+        const state = yield* openRuntime(harness, {
+          // Both runs hold after their first chunk, so the steer always
+          // lands while a child is still working.
+          T3_MOCK_HANG: "1",
+        });
+
+        const runId = yield* startTurn(state, "primero");
+        const providerTurnId = yield* runningTurnId(state);
+        yield* firstAssistantText(state);
+
+        yield* steerTurn(state, runId, providerTurnId, "segundo");
+
+        const events = yield* state.collectUntilTerminal();
+        const terminal = events.at(-1);
+        expect(terminal?.type).toBe("turn.terminal");
+        expect(terminal?.type === "turn.terminal" && terminal.status).toBe("completed");
+
+        // Exactly one terminal: the steer continued the running turn rather
+        // than starting a second one.
+        expect(events.filter((event) => event.type === "turn.terminal")).toHaveLength(1);
+
+        // The queued prompt ran after the first process exited, resuming
+        // the same Command Code session under the same turn.
+        const steeredArgv = readArgvLog(harness.argvLogPath);
+        expect(steeredArgv.prompt).toBe("segundo");
+        expect(steeredArgv.argv).toContain("--resume");
+        expect(steeredArgv.argv).toContain("mock-session-1");
+      }).pipe(
+        Effect.ensuring(cleanupHarness(harness.cwd)),
+        Effect.scoped,
+        Effect.provide(testLayer),
+      );
+    },
+    30_000,
+  );
+
+  it.live(
+    "names the mid-turn messages a failed turn never delivered",
+    () => {
+      const harness = prepareMockHarness();
+      return Effect.gen(function* () {
+        const state = yield* openRuntime(harness, {
+          // Hold the first process, then fail the run while a steer waits.
+          T3_MOCK_HANG: "1",
+          T3_MOCK_EXIT_CODE: "8",
+        });
+
+        const runId = yield* startTurn(state, "primero");
+        const providerTurnId = yield* runningTurnId(state);
+        yield* firstAssistantText(state);
+
+        yield* steerTurn(state, runId, providerTurnId, "segundo");
+
+        const events = yield* state.collectUntilTerminal();
+        const terminal = events.at(-1);
+        expect(terminal?.type).toBe("turn.terminal");
+        expect(terminal?.type === "turn.terminal" && terminal.status).toBe("failed");
+
+        const notice = events.find(
+          (
+            event,
+          ): event is ProviderAdapterV2Event & {
+            readonly type: "turn_item.updated";
+            readonly turnItem: { readonly type: "system_notice"; readonly message: string };
+          } => event.type === "turn_item.updated" && event.turnItem.type === "system_notice",
+        );
+        expect(
+          notice !== undefined &&
+            notice.turnItem.message.includes(
+              "1 message sent while this turn ran was not delivered; resend to continue.",
+            ),
+        ).toBe(true);
+      }).pipe(
+        Effect.ensuring(cleanupHarness(harness.cwd)),
+        Effect.scoped,
+        Effect.provide(testLayer),
+      );
+    },
+    30_000,
+  );
+});
