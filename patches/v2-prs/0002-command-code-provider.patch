+/**
+ * CommandCodeAdapterV2 — orchestrator-v2 adapter for the Command Code CLI.
+ *
+ * Command Code has no long-lived app-server session to talk JSON-RPC to:
+ * headless mode is one `-p` subprocess per turn, resumable by session id.
+ * `startTurn` therefore spawns a fresh CLI, pipes the prompt over stdin,
+ * parses the NDJSON event stream on stdout live, and folds it into v2
+ * turn items and messages. A turn ends when the subprocess exits.
+ *
+ * A steer that lands while a turn is running cannot reach the live CLI
+ * (print mode takes one prompt per process): it queues on the active run
+ * and starts its own process as soon as the one in flight exits, resuming
+ * the same Command Code session under the same provider turn — the message
+ * is never rejected or dropped. An interrupt kills the child, which the
+ * adapter reports as a clean abort, never a provider failure.
+ *
+ * Headless print mode cannot surface interactive approvals, so the adapter
+ * never opens runtime requests: the permission policy is a launch flag
+ * (`--yolo` for auto-accept, nothing for standard/read-only).
+ *
+ * @module orchestration-v2/Adapters/CommandCodeAdapterV2
+ */
+import { HostProcessEnvironment } from "@t3tools/shared/hostProcess";
+import {
+  CommandCodeSettings,
+  ProviderDriverKind,
+  defaultInstanceIdForDriver,
+  type ThreadId,
+  type OrchestrationV2ConversationMessage,
+  type OrchestrationV2ExecutionNode,
+  type OrchestrationV2ProviderCapabilities,
+  type OrchestrationV2ProviderFailure,
+  type OrchestrationV2ProviderRef,
+  type OrchestrationV2ProviderSession,
+  type OrchestrationV2ProviderThread,
+  type OrchestrationV2ProviderTurn,
+  type OrchestrationV2TurnItem,
+  type ProviderInstanceId,
+} from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import type * as Sink from "effect/Sink";
+import * as Stream from "effect/Stream";
+import { ChildProcess, ChildProcessSpawner } from "effect/unstable/process";
+import { resolveSpawnCommand } from "@t3tools/shared/shell";
+
+import { ServerConfig } from "../../config.ts";
+import { mergeProviderInstanceEnvironment } from "../../provider/ProviderInstanceEnvironment.ts";
+import { commandCodeTurnArgs } from "../../provider/commandCodeLaunchArgs.ts";
+import { IdAllocatorV2 } from "../IdAllocator.ts";
+import {
+  ProviderAdapterDriverCreateError,
+  type ProviderAdapterDriver,
+  type ProviderAdapterDriverCreateInput,
+} from "../ProviderAdapterDriver.ts";
+import {
+  ProviderAdapterEnsureThreadError,
+  ProviderAdapterForkThreadError,
+  ProviderAdapterInterruptError,
+  ProviderAdapterProtocolError,
+  ProviderAdapterReadThreadSnapshotError,
+  ProviderAdapterResumeThreadError,
+  ProviderAdapterRollbackThreadError,
+  ProviderAdapterRuntimeRequestResponseError,
+  ProviderAdapterSteerRunError,
+  ProviderAdapterTurnStartError,
+  ProviderAdapterV2,
+  type ProviderAdapterV2Error,
+  type ProviderAdapterV2Event,
+  type ProviderAdapterV2OpenSessionInput,
+  type ProviderAdapterV2RuntimePolicy,
+  type ProviderAdapterV2SessionRuntime,
+  type ProviderAdapterV2Shape,
+  type ProviderAdapterV2TurnInput,
+} from "../ProviderAdapter.ts";
+import { makeProviderFailure } from "../ProviderFailure.ts";
+import { turnScopedSelectionTransition } from "../ProviderSelectionTransition.ts";
+
+export const COMMAND_CODE_PROVIDER = ProviderDriverKind.make("commandCode");
+const COMMAND_CODE_DRIVER_KIND = COMMAND_CODE_PROVIDER;
+const COMMAND_CODE_DEFAULT_INSTANCE_ID = defaultInstanceIdForDriver(COMMAND_CODE_DRIVER_KIND);
+const DEFAULT_COMMAND_CODE_SETTINGS = Schema.decodeSync(CommandCodeSettings)({});
+
+const STREAM_FLUSH_MS = 50;
+/** Keeps failure messages well below the contract's 4_096 cap. */
+const FAILURE_MESSAGE_MAX = 2_000;
+const STDERR_TAIL_MAX = 8_000;
+const ANSI_ESCAPE_REGEX = /\u001b\[[0-9;]*m/g;
+
+// ── NDJSON frame parsing ────────────────────────────────────────────
+
+export interface CommandCodeEventFrame {
+  readonly type: string;
+  readonly [key: string]: unknown;
+}
+
+export type CommandCodeParsedLine =
+  | { readonly kind: "frame"; readonly frame: CommandCodeEventFrame }
+  | {
+      readonly kind: "result";
+      readonly result: {
+        readonly subtype?: unknown;
+        readonly sessionId?: unknown;
+        readonly stopReason?: unknown;
+        readonly usage?: unknown;
+        readonly error?: unknown;
+        readonly finalText?: unknown;
+      };
+    }
+  | { readonly kind: "skip" };
+
+/** Parse one NDJSON line from `command-code -p --output-format json`. */
+export function parseCommandCodeNdjsonLine(line: string): CommandCodeParsedLine {
+  const trimmed = line.trim();
+  if (trimmed.length === 0) {
+    return { kind: "skip" };
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(trimmed);
+  } catch {
+    return { kind: "skip" };
+  }
+  if (parsed === null || typeof parsed !== "object") {
+    return { kind: "skip" };
+  }
+  const record = parsed as Record<string, unknown>;
+  if (record["type"] === "event") {
+    const event = record["event"];
+    if (event !== null && typeof event === "object") {
+      return { kind: "frame", frame: event as CommandCodeEventFrame };
+    }
+    return { kind: "skip" };
+  }
+  if (record["type"] === "result") {
+    return {
+      kind: "result",
+      result: {
+        subtype: record["subtype"],
+        sessionId: record["sessionId"],
+        stopReason: record["stopReason"],
+        usage: record["usage"],
+        error: record["error"],
+        finalText: record["finalText"],
+      },
+    };
+  }
+  return { kind: "skip" };
+}
+
+// ── payload helpers ─────────────────────────────────────────────────
+
+interface UsageTotals {
+  readonly inputTokens?: number;
+  readonly outputTokens?: number;
+  readonly cacheReadTokens?: number;
+  readonly cacheWriteTokens?: number;
+}
+
+function readUsage(value: unknown): UsageTotals | undefined {
+  if (value === null || typeof value !== "object") return undefined;
+  const record = value as Record<string, unknown>;
+  const numberOrUndefined = (key: string): number | undefined =>
+    typeof record[key] === "number" ? (record[key] as number) : undefined;
+  return {
+    ...(numberOrUndefined("inputTokens") !== undefined
+      ? { inputTokens: numberOrUndefined("inputTokens") as number }
+      : {}),
+    ...(numberOrUndefined("outputTokens") !== undefined
+      ? { outputTokens: numberOrUndefined("outputTokens") as number }
+      : {}),
+    ...(numberOrUndefined("cacheReadTokens") !== undefined
+      ? { cacheReadTokens: numberOrUndefined("cacheReadTokens") as number }
+      : {}),
+    ...(numberOrUndefined("cacheWriteTokens") !== undefined
+      ? { cacheWriteTokens: numberOrUndefined("cacheWriteTokens") as number }
+      : {}),
+  };
+}
+
+function summarizeToolInput(input: unknown): string | undefined {
+  if (typeof input === "string") {
+    const trimmed = input.trim();
+    return trimmed.length > 0 ? trimmed.slice(0, 240) : undefined;
+  }
+  if (input === null || typeof input !== "object") return undefined;
+  const record = input as Record<string, unknown>;
+  const filePath = typeof record["file_path"] === "string" ? record["file_path"] : undefined;
+  const command = typeof record["command"] === "string" ? record["command"] : undefined;
+  const value = filePath ?? command;
+  if (typeof value === "string" && value.trim().length > 0) {
+    return value.trim().slice(0, 240);
+  }
+  return undefined;
+}
+
+type CommandCodeToolItemType = "command_execution" | "file_change" | "dynamic_tool";
+
+function itemTypeForTool(toolName: string): CommandCodeToolItemType {
+  if (toolName === "shell_command" || toolName === "bash" || toolName === "powershell") {
+    return "command_execution";
+  }
+  if (
+    toolName === "write_file" ||
+    toolName === "edit_file" ||
+    toolName === "apply_patch" ||
+    toolName === "multi_edit"
+  ) {
+    return "file_change";
+  }
+  return "dynamic_tool";
+}
+
+function stringFrame(frame: CommandCodeEventFrame, key: string): string | undefined {
+  const value = frame[key];
+  return typeof value === "string" ? value : undefined;
+}
+
+// ── per-session state ───────────────────────────────────────────────
+
+/** Structural view of the spawner's child handle, kept wide so the adapter
+ * stays independent of the process module's exact stream/sink generics. */
+interface TurnChildHandle {
+  /** Fails when the process was terminated by a signal rather than exiting. */
+  readonly exitCode: Effect.Effect<number, Error>;
+  readonly kill: (options?: { readonly forceKillAfter?: unknown }) => Effect.Effect<void>;
+  readonly stdout: Stream.Stream<Uint8Array, never>;
+  readonly stderr: Stream.Stream<Uint8Array, never>;
+  readonly stdin: Sink.Sink<void, Uint8Array, never, never>;
+}
+
+interface CommandCodeStreamItem {
+  readonly nativeItemId: string;
+  readonly kind: "assistant_message" | "reasoning";
+  text: string;
+  completed: boolean;
+  flushScheduled: boolean;
+  readonly startedAt: DateTime.Utc;
+}
+
+type SinglePromptOutcome =
+  | { readonly outcome: "completed"; readonly usage: UsageTotals | undefined }
+  | { readonly outcome: "interrupted"; readonly usage: UsageTotals | undefined }
+  | {
+      readonly outcome: "failed";
+      readonly usage: undefined;
+      readonly failure: OrchestrationV2ProviderFailure;
+    };
+
+interface ActiveCommandCodeTurn {
+  readonly turnInput: ProviderAdapterV2TurnInput;
+  readonly providerTurn: OrchestrationV2ProviderTurn;
+  /**
+   * Shared with the interrupt path. Kept on the run itself so a run that
+   * outlives its session entry still observes its own interruption.
+   */
+  readonly cancel: { requested: boolean };
+  /** Null between a prompt's completion and the next process spawning. */
+  child: TurnChildHandle | null;
+  /**
+   * Steered prompts that arrived while this run's process was still working.
+   * Headless print mode takes exactly one prompt per process, so a steer
+   * cannot reach the live CLI: it waits here and runs as the same turn once
+   * the current process exits, resuming the same Command Code session.
+   */
+  queuedPrompts: ReadonlyArray<string>;
+  readonly itemOrdinals: Map<string, number>;
+  nextItemOrdinal: number;
+  /** Increments on each assistant `message_start` so item ids stay unique. */
+  messageOrdinal: number;
+  /** Increments on each `thinking_start`. */
+  reasoningOrdinal: number;
+  activeAssistantItemId: string | null;
+  readonly streamItems: Map<string, CommandCodeStreamItem>;
+  /** First-seen time per tool so updates keep one start timestamp. */
+  readonly toolStartedAt: Map<string, DateTime.Utc>;
+  failure: OrchestrationV2ProviderFailure | null;
+}
+
+interface CommandCodeThreadState {
+  providerThread: OrchestrationV2ProviderThread;
+  cwd: string;
+  /** Command Code headless session id; null until the first turn reports one. */
+  commandCodeSessionId: string | null;
+  activeTurn: ActiveCommandCodeTurn | null;
+}
+
+// ── capabilities ────────────────────────────────────────────────────
+
