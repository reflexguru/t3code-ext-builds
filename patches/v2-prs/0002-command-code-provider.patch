+
+// ── adapter ─────────────────────────────────────────────────────────
+
+export interface CommandCodeAdapterV2Options {
+  readonly instanceId: ProviderInstanceId;
+  readonly settings: CommandCodeSettings;
+  readonly environment: NodeJS.ProcessEnv;
+  readonly spawner: ChildProcessSpawner.ChildProcessSpawner["Service"];
+  readonly idAllocator: IdAllocatorV2["Service"];
+  readonly serverConfig: ServerConfig["Service"];
+}
+
+export function makeCommandCodeAdapterV2(
+  options: CommandCodeAdapterV2Options,
+): ProviderAdapterV2Shape {
+  const { idAllocator } = options;
+
+  const protocolError = (detail: string, payload?: unknown) =>
+    new ProviderAdapterProtocolError({
+      driver: COMMAND_CODE_DRIVER_KIND,
+      detail,
+      ...(payload === undefined ? {} : { payload }),
+    });
+
+  return ProviderAdapterV2.of({
+    instanceId: options.instanceId,
+    driver: COMMAND_CODE_PROVIDER,
+    getCapabilities: () => Effect.succeed(CommandCodeProviderCapabilitiesV2),
+    planSelectionTransition: () => Effect.succeed(turnScopedSelectionTransition()),
+    openSession: Effect.fn("CommandCodeAdapterV2.openSession")(function* (
+      input: ProviderAdapterV2OpenSessionInput,
+    ) {
+      const scope = yield* Effect.scope;
+      const cwd = input.runtimePolicy.cwd ?? options.serverConfig.cwd;
+      const now = yield* DateTime.now;
+      let sessionEntity: OrchestrationV2ProviderSession = {
+        id: input.providerSessionId,
+        driver: COMMAND_CODE_PROVIDER,
+        providerInstanceId: options.instanceId,
+        status: "ready",
+        cwd,
+        model: input.modelSelection.model,
+        capabilities: CommandCodeProviderCapabilitiesV2,
+        createdAt: now,
+        updatedAt: now,
+        lastError: null,
+      };
+      const events = yield* Queue.unbounded<
+        ProviderAdapterV2Event,
+        ProviderAdapterV2Error | Cause.Done
+      >();
+      let threadState: CommandCodeThreadState | null = null;
+
+      const emit = (event: ProviderAdapterV2Event) =>
+        Queue.offer(events, event).pipe(Effect.asVoid);
+
+      const providerRef = (
+        nativeId: string | null,
+        strength: "strong" | "weak" = "strong",
+      ): OrchestrationV2ProviderRef => ({
+        driver: COMMAND_CODE_PROVIDER,
+        nativeId,
+        strength,
+      });
+
+      const updateProviderSession = (
+        status: OrchestrationV2ProviderSession["status"],
+        lastError: string | null = sessionEntity.lastError,
+      ) =>
+        Effect.gen(function* () {
+          const updatedAt = yield* DateTime.now;
+          sessionEntity = { ...sessionEntity, status, lastError, updatedAt };
+          yield* emit({
+            type: "provider_session.updated",
+            driver: COMMAND_CODE_PROVIDER,
+            providerSession: sessionEntity,
+          });
+        });
+
+      /** Persist the Command Code session id the run reported so later turns `--resume` it. */
+      const adoptCommandCodeSessionId = (state: CommandCodeThreadState, sessionId: string) =>
+        Effect.gen(function* () {
+          state.commandCodeSessionId = sessionId;
+          const updatedAt = yield* DateTime.now;
+          state.providerThread = {
+            ...state.providerThread,
+            nativeThreadRef: providerRef(sessionId),
+            updatedAt,
+          };
+          yield* emit({
+            type: "provider_thread.updated",
+            driver: COMMAND_CODE_PROVIDER,
+            providerThread: state.providerThread,
+          });
+        });
+
+      const registerThread = Effect.fnUntraced(function* (
+        threadInput: {
+          readonly threadId: ThreadId;
+          readonly existingProviderThread?: OrchestrationV2ProviderThread | undefined;
+          readonly runtimePolicy: ProviderAdapterV2RuntimePolicy;
+        },
+        publish = true,
+      ) {
+        const existing = threadInput.existingProviderThread;
+        // Adopting a persisted thread: its nativeThreadRef carries the Command
+        // Code session id to `--resume`, so the conversation continues.
+        const resumedSessionId =
+          typeof existing?.nativeThreadRef?.nativeId === "string"
+            ? existing.nativeThreadRef.nativeId
+            : null;
+        const createdAt = yield* DateTime.now;
+        const providerThread: OrchestrationV2ProviderThread =
+          existing !== undefined
+            ? {
+                ...existing,
+                providerSessionId: input.providerSessionId,
+                nativeThreadRef: providerRef(resumedSessionId),
+                status: "idle",
+                updatedAt: createdAt,
+              }
+            : {
+                id: idAllocator.derive.providerThread({
+                  driver: COMMAND_CODE_PROVIDER,
+                  nativeThreadId: threadInput.threadId,
+                }),
+                driver: COMMAND_CODE_PROVIDER,
+                providerInstanceId: options.instanceId,
+                providerSessionId: input.providerSessionId,
+                appThreadId: threadInput.threadId,
+                ownerNodeId: null,
+                nativeThreadRef: providerRef(null, "weak"),
+                nativeConversationHeadRef: null,
+                status: "idle",
+                firstRunOrdinal: null,
+                lastRunOrdinal: null,
+                handoffIds: [],
+                forkedFrom: null,
+                pendingBackgroundTasks: [],
+                createdAt,
+                updatedAt: createdAt,
+              };
+        threadState = {
+          providerThread,
+          cwd: threadInput.runtimePolicy.cwd ?? cwd,
+          commandCodeSessionId: resumedSessionId,
+          activeTurn: null,
+        };
+        if (publish)
+          yield* emit({
+            type: "provider_thread.updated",
+            driver: COMMAND_CODE_PROVIDER,
+            providerThread,
+          });
+        return providerThread;
+      });
+
+      // ── item / message emission ─────────────────────────
+
+      const itemOrdinal = (turn: ActiveCommandCodeTurn, nativeItemId: string): number => {
+        const existing = turn.itemOrdinals.get(nativeItemId);
+        if (existing !== undefined) return existing;
+        const ordinal = turn.nextItemOrdinal++;
+        turn.itemOrdinals.set(nativeItemId, ordinal);
+        return ordinal;
+      };
+
+      const baseItemFields = (
+        turn: ActiveCommandCodeTurn,
+        nativeItemId: string,
+        startedAt: DateTime.Utc,
+        updatedAt: DateTime.Utc,
+      ) => ({
+        id: idAllocator.derive.turnItemFromProviderItem({
+          driver: COMMAND_CODE_PROVIDER,
+          nativeItemId,
+        }),
+        threadId: turn.turnInput.threadId,
+        runId: turn.turnInput.runId,
+        nodeId: idAllocator.derive.nodeFromProviderItem({
+          driver: COMMAND_CODE_PROVIDER,
+          nativeItemId,
+        }),
+        providerThreadId: turn.turnInput.providerThread.id,
+        providerTurnId: turn.providerTurn.id,
+        nativeItemRef: providerRef(nativeItemId),
+        parentItemId: null,
+        ordinal: itemOrdinal(turn, nativeItemId),
+        startedAt,
+        updatedAt,
+      });
+
+      const emitItemNode = (
+        turn: ActiveCommandCodeTurn,
+        nativeItemId: string,
+        kind: OrchestrationV2ExecutionNode["kind"],
+        status: OrchestrationV2ExecutionNode["status"],
+        startedAt: DateTime.Utc,
+        completedAt: DateTime.Utc | null,
+      ) =>
+        emit({
+          type: "node.updated",
+          driver: COMMAND_CODE_PROVIDER,
+          node: {
+            id: idAllocator.derive.nodeFromProviderItem({
+              driver: COMMAND_CODE_PROVIDER,
+              nativeItemId,
+            }),
+            threadId: turn.turnInput.threadId,
+            runId: turn.turnInput.runId,
+            parentNodeId: turn.turnInput.rootNodeId,
+            rootNodeId: turn.turnInput.rootNodeId,
+            kind,
+            status,
+            countsForRun: false,
+            providerThreadId: turn.turnInput.providerThread.id,
+            providerTurnId: turn.providerTurn.id,
+            nativeItemRef: providerRef(nativeItemId),
+            runtimeRequestId: null,
+            checkpointScopeId: null,
+            startedAt,
+            completedAt,
+          },
+        });
+
+      const emitStreamItem = (
+        turn: ActiveCommandCodeTurn,
+        item: CommandCodeStreamItem,
+        streaming: boolean,
+      ) =>
+        Effect.gen(function* () {
+          const emittedAt = yield* DateTime.now;
+          const base = baseItemFields(turn, item.nativeItemId, item.startedAt, emittedAt);
+          yield* emitItemNode(
+            turn,
+            item.nativeItemId,
+            item.kind,
+            streaming ? "running" : "completed",
+            item.startedAt,
+            streaming ? null : emittedAt,
+          );
+          if (item.kind === "assistant_message") {
+            const messageId = idAllocator.derive.messageFromProviderItem({
+              driver: COMMAND_CODE_PROVIDER,
+              nativeItemId: item.nativeItemId,
+            });
+            yield* emit({
+              type: "turn_item.updated",
+              driver: COMMAND_CODE_PROVIDER,
+              turnItem: {
+                ...base,
+                status: streaming ? "running" : "completed",
+                title: null,
+                completedAt: streaming ? null : emittedAt,
+                type: "assistant_message",
+                messageId,
+                text: item.text,
+                streaming,
+              },
+            });
+            const message: OrchestrationV2ConversationMessage = {
+              id: messageId,
+              threadId: turn.turnInput.threadId,
+              runId: turn.turnInput.runId,
+              nodeId: idAllocator.derive.nodeFromProviderItem({
+                driver: COMMAND_CODE_PROVIDER,
+                nativeItemId: item.nativeItemId,
+              }),
+              role: "assistant",
+              text: item.text,
+              attachments: [],
+              streaming,
+              createdBy: "agent",
+              creationSource: "provider",
+              createdAt: item.startedAt,
+              updatedAt: emittedAt,
+            };
+            yield* emit({
+              type: "message.updated",
+              driver: COMMAND_CODE_PROVIDER,
+              message,
+            });
+            return;
+          }
+          yield* emit({
+            type: "turn_item.updated",
+            driver: COMMAND_CODE_PROVIDER,
+            turnItem: {
+              ...base,
+              status: streaming ? "running" : "completed",
+              title: null,
+              completedAt: streaming ? null : emittedAt,
+              type: "reasoning",
+              text: item.text,
+              streaming,
+            },
+          });
+        });
+
+      /** Coalesce token-level deltas into a bounded event rate. */
+      const scheduleStreamFlush = (turn: ActiveCommandCodeTurn, item: CommandCodeStreamItem) =>
+        Effect.gen(function* () {
+          if (item.flushScheduled || item.completed) return;
+          item.flushScheduled = true;
+          yield* Effect.sleep(Duration.millis(STREAM_FLUSH_MS)).pipe(
+            Effect.andThen(
+              Effect.suspend(() => {
+                item.flushScheduled = false;
+                return item.completed ? Effect.void : emitStreamItem(turn, item, true);
+              }),
+            ),
+            Effect.forkIn(scope),
+          );
+        });
+
+      const streamItemFor = Effect.fnUntraced(function* (
+        turn: ActiveCommandCodeTurn,
+        kind: CommandCodeStreamItem["kind"],
+        nativeItemId: string,
+      ) {
+        const existing = turn.streamItems.get(nativeItemId);
+        if (existing !== undefined) return existing;
+        const startedAt = yield* DateTime.now;
+        const item: CommandCodeStreamItem = {
+          nativeItemId,
+          kind,
+          text: "",
+          completed: false,
+          flushScheduled: false,
+          startedAt,
+        };
+        turn.streamItems.set(nativeItemId, item);
+        // Ordinal reserved on first delta so items appear in stream order.
+        itemOrdinal(turn, nativeItemId);
+        return item;
+      });
+
+      const completeStreamItem = (
+        turn: ActiveCommandCodeTurn,
+        item: CommandCodeStreamItem,
+        text?: string,
+      ) =>
+        Effect.suspend(() => {
+          if (item.completed) return Effect.void;
+          item.completed = true;
+          if (text !== undefined && text.length > 0) item.text = text;
+          return item.text.length === 0 ? Effect.void : emitStreamItem(turn, item, false);
+        });
+
+      const completeOpenStreamItems = (turn: ActiveCommandCodeTurn) =>
+        Effect.forEach(
+          Array.from(turn.streamItems.values()).filter((item) => !item.completed),
+          (item) => completeStreamItem(turn, item),
+          { discard: true },
+        );
+
+      const toolTurnItem = (
+        turn: ActiveCommandCodeTurn,
+        frame: CommandCodeEventFrame,
+        status: OrchestrationV2TurnItem["status"],
+        startedAt: DateTime.Utc,
+        emittedAt: DateTime.Utc,
+        errorOutput: string | undefined,
+      ): OrchestrationV2TurnItem => {
+        const toolCallId = stringFrame(frame, "toolCallId") ?? "unknown";
+        const toolName = stringFrame(frame, "toolName") ?? "tool";
+        const itemType = itemTypeForTool(toolName);
+        const detail = summarizeToolInput(frame["input"]);
+        const description = stringFrame(frame, "description");
+        const base = baseItemFields(turn, `tool-${toolCallId}`, startedAt, emittedAt);
+        const shared = {
+          ...base,
+          status,
+          title: toolName,
+          completedAt: status === "running" ? null : emittedAt,
+        };
+        if (itemType === "command_execution") {
+          return {
+            ...shared,
+            type: "command_execution",
+            input: detail ?? "",
+            ...(description !== undefined && description.length > 0
+              ? { output: description }
+              : errorOutput !== undefined && errorOutput.length > 0
+                ? { output: errorOutput }
+                : {}),
+          };
+        }
+        if (itemType === "file_change") {
+          return {
+            ...shared,
+            type: "file_change",
+            fileName: detail ?? toolName,
+          };
+        }
+        return {
+          ...shared,
+          type: "dynamic_tool",
+          toolName,
+          input: detail ?? {},
+          ...(description !== undefined && description.length > 0
+            ? { output: description }
+            : errorOutput !== undefined && errorOutput.length > 0
+              ? { output: errorOutput }
+              : {}),
+        };
+      };
+
+      const emitToolItem = Effect.fnUntraced(function* (
+        turn: ActiveCommandCodeTurn,
+        frame: CommandCodeEventFrame,
+        status: OrchestrationV2TurnItem["status"],
+        errorOutput?: string,
+      ) {
