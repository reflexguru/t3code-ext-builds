@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { commandCodeTurnArgs } from "./commandCodeLaunchArgs.ts";
+
+describe("commandCodeTurnArgs", () => {
+  it("passes --effort after --model when the level is recognized", () => {
+    expect(
+      commandCodeTurnArgs({
+        permissionMode: "auto-accept",
+        model: "claude-sonnet-5",
+        effort: "xhigh",
+      }),
+    ).toEqual([
+      "-p",
+      "--output-format",
+      "json",
+      "--skip-onboarding",
+      "--yolo",
+      "--model",
+      "claude-sonnet-5",
+      "--effort",
+      "xhigh",
+    ]);
+  });
+
+  it("omits --effort for blank or unknown levels", () => {
+    expect(
+      commandCodeTurnArgs({
+        permissionMode: "standard",
+        model: "claude-sonnet-5",
+        effort: "turbo",
+      }),
+    ).not.toContain("--effort");
+    expect(
+      commandCodeTurnArgs({
+        permissionMode: "standard",
+        model: "claude-sonnet-5",
+      }),
+    ).not.toContain("--effort");
+  });
+});
