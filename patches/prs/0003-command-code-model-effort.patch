+/** CLI `--effort` / `/effort` levels advertised in Command Code settings. */
+export const COMMAND_CODE_EFFORT_VALUES = ["low", "medium", "high", "xhigh", "max"] as const;
+export type CommandCodeEffort = (typeof COMMAND_CODE_EFFORT_VALUES)[number];
+
+/**
+ * Reasoning control shown on every Command Code model. The CLI accepts these
+ * values on `--effort`; the picker is advertised for all models so T3 matches
+ * other providers instead of hiding the control.
+ */
+export const COMMAND_CODE_MODEL_CAPABILITIES: ModelCapabilities = createModelCapabilities({
+  optionDescriptors: [
+    {
+      id: "effort",
+      label: "Reasoning",
+      type: "select",
+      currentValue: "high",
+      options: [
+        { id: "low", label: "Low" },
+        { id: "medium", label: "Medium" },
+        { id: "high", label: "High", isDefault: true },
+        { id: "xhigh", label: "Extra High" },
+        { id: "max", label: "Max" },
+      ],
+    },
+  ],
+});
+
+export function normalizeCommandCodeEffort(
+  value: string | undefined,
+): CommandCodeEffort | undefined {
+  if (value === undefined) return undefined;
+  const trimmed = value.trim().toLowerCase();
+  return (COMMAND_CODE_EFFORT_VALUES as readonly string[]).includes(trimmed)
+    ? (trimmed as CommandCodeEffort)
+    : undefined;
+}
